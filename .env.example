# WhatsApp Business API Configuration
# Dapatkan dari Meta for Developers

# WhatsApp Business API Token (System User Token)
WHATSAPP_TOKEN=your_whatsapp_business_token_here

# WhatsApp Phone Number ID
PHONE_NUMBER_ID=your_phone_number_id_here

# Webhook Verification Token (bebas, tapi harus sama dengan di dashboard Meta)
WEBHOOK_VERIFY_TOKEN=your_verify_token_here

# Webhook URL (publicly accessible URL for your backend)
WEBHOOK_URL=https://your-domain.com/webhook

# Flutter API Configuration
FLUTTER_API_URL=http://localhost:8080/api
FLUTTER_API_TOKEN=your_flutter_api_token_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (sesuaikan dengan setup Anda)
DATABASE_URL=your_database_url_here